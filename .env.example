# ByteHR AI — Environment Configuration
# Copy this file to .env and fill in the values before starting the stack.

# ─── Database ───────────────────────────────────────────────────────────────
DB_NAME=bytehr
DB_USERNAME=bytehr
DB_PASSWORD=changeme_strong_password
DB_PORT=5432

# ─── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:1.7b
# Embedding timeout: 120s covers cold model load (~10s) plus generation (<1s)
OLLAMA_EMBEDDING_TIMEOUT=120
# Chat timeout: qwen3:1.7b ~5-15s on CPU with think:false; 300s for complex prompts
OLLAMA_CHAT_TIMEOUT=300
# Temperature 0.0 = deterministic, no creativity (required for strict RAG mode)
OLLAMA_CHAT_TEMPERATURE=0.0

# ─── RAG Configuration ──────────────────────────────────────────────────────
# topK: chunks retrieved per query (3 = demo, 5-10 = production)
BYTEHR_RAG_TOP_K=3
# max-context-chars: total document chars sent to LLM (1500 = demo, 3000+ = production)
BYTEHR_RAG_MAX_CONTEXT_CHARS=1500
# strict-mode: true = LLM only answers from retrieved context (recommended)
BYTEHR_RAG_STRICT_MODE=true

# ─── Security / Redaction ────────────────────────────────────────────────────
# PII redaction before document text enters the vector database
BYTEHR_REDACTION_ENABLED=true

# ─── Document Source ────────────────────────────────────────────────────────
# "local" for hackathon MVP (reads from sample-data/hr-documents/)
# "sharepoint" for production (reads from Microsoft SharePoint)
BYTEHR_SOURCE_TYPE=local
BYTEHR_LOCAL_PATH=./docs/sample-data/hr-documents


# Obtain these from your Azure App Registration.
#
# auth-mode=app (default): app-only client-credentials auth.
#   Required permissions: Sites.Read.All, Files.Read.All (Application) + admin consent.
#   Needs SHAREPOINT_CLIENT_SECRET, SHAREPOINT_SITE_ID, SHAREPOINT_DRIVE_ID.
#
# auth-mode=delegated: sign in as yourself via device code (no client secret needed).
#   Reads directly from YOUR OWN OneDrive via /me/drive — no site/drive ID lookup.
#   Required permission: Files.Read (Delegated) — usually just needs your own consent,
#   not tenant-admin consent. App registration must allow "Public client flows".
#   Leave SHAREPOINT_CLIENT_SECRET / SITE_ID / DRIVE_ID blank in this mode.
SHAREPOINT_AUTH_MODE=delegated
SHAREPOINT_TENANT_ID=your-azure-tenant-id
SHAREPOINT_CLIENT_ID=your-azure-app-client-id
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# Optional: scope sync to a specific subfolder (e.g. ByteHR). Leave blank to scan the whole drive/OneDrive.
SHAREPOINT_FOLDER_PATH=ByteHR
SHAREPOINT_SYNC_ENABLED=true

# ─── Microsoft Teams Bot ────────────────────────────────────────────────────
# Obtain from Azure Bot Service registration.
TEAMS_APP_ID=your-teams-bot-app-id
TEAMS_APP_PASSWORD=your-teams-bot-app-password

# ─── API Server ─────────────────────────────────────────────────────────────
SERVER_PORT=8080
